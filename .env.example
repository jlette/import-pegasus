# Configuration du Normalisateur des admissions PEGASUS.
#
# Ce fichier est un MODÈLE : il ne contient aucun secret réel et peut être versionné.
# En production, ces variables sont définies par le vhost Apache (SetEnv) ou par
# l'unité systemd — jamais dans un fichier du dépôt.

# Environnement : "production" (défaut) ou "development".
# En production, aucune erreur PHP n'est affichée au navigateur.
APP_ENV=development

# Préfixe d'URL de l'application, sans barre oblique finale.
APP_BASE_URL=/import-pegasus

# Annuaire Oracle (schéma ANNUAIRE de la base Jefyco) — accès en LECTURE SEULE.
# Le schéma ANNUAIRE possède son propre mot de passe, géré dans le coffre du CRI.
# Ne pas utiliser le compte grhum.
PEGASUS_DB_HOST=oracle1.cri.ulm
PEGASUS_DB_PORT=1521
PEGASUS_DB_NAME=jefyco
PEGASUS_DB_USER=
PEGASUS_DB_PASSWORD=
